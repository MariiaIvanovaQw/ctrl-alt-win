# Скопируйте в .env и при необходимости измените. Все переменные — с префиксом APP_.
#
# По умолчанию (без .env) API запускается безопасно: APP_ENV=prod, демо-режим
# выключен, заглушки ФСП ID нет. Этот пример включает режим локальной
# разработки и демонстрации.
APP_ENV=dev
# Демо-стенд для жюри: экспресс-режим теста и сброс попыток (/api/v1/dev/*),
# ссылки подтверждения почты и согласия представителя в ответах API, список
# демо-учёток без пароля модератора. Не включать на данных реальных людей.
APP_DEMO_MODE=true
APP_PUBLIC_BASE_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:5173
# APP_CORS_ORIGINS=["http://localhost:5173"]

# По умолчанию SQLite в каталоге data/. Для PostgreSQL:
# APP_DATABASE_URL=postgresql+psycopg://talent:talent@localhost:5432/talent

# Аутентификация: local — встроенный провайдер (токены в формате Keycloak),
# keycloak — токены выпускает внешний Keycloak, API их только проверяет.
APP_AUTH_MODE=local
# APP_KEYCLOAK_ISSUER=http://localhost:8080/realms/platform
# APP_KEYCLOAK_AUDIENCE=talent-api

# Почта: без SMTP письма не отправляются, их копии хранятся в базе платформы
# (outbox_emails, APP_OUTBOX_RETENTION_DAYS дней). В демо-режиме ссылка
# подтверждения адреса приходит в ответе регистрации.
# APP_SMTP_HOST=localhost
# APP_SMTP_PORT=1025
APP_OUTBOX_RETENTION_DAYS=30

# ФСП ID: inprocess — встроенная заглушка (/mock-fsp, только при APP_ENV=dev или
# APP_DEMO_MODE=true), oidc — настоящий провайдер.
APP_FSP_MODE=inprocess
# APP_FSP_ISSUER=https://<сервер ФСП ID>/realms/<realm>
# APP_FSP_API_URL=https://<реестр достижений ФСП>
# APP_FSP_CLIENT_ID=
# APP_FSP_CLIENT_SECRET=

# Вход: лимиты неудачных попыток за 15 минут (счётчика «только по почте» нет —
# иначе любой мог бы заблокировать чужой вход)
APP_LOGIN_FAILURES_PER_ACCOUNT_IP=10
APP_LOGIN_FAILURES_PER_IP=50
APP_PASSWORD_RESET_TTL_MINUTES=60

# Правила тестирования
APP_GRADE_CHANGE_COOLDOWN_DAYS=90
APP_SAME_LEVEL_RETRY_DAYS=30
APP_RECOMMENDATION_CLEAN_DAYS=180

# Несовершеннолетние: тест — с 14 лет, показ работодателям и приглашения — с 15 лет
APP_MIN_CANDIDATE_AGE=14
APP_MIN_WORK_AGE=15

# Защита от недобросовестных работодателей
APP_TRUST_WINDOW_DAYS=30
APP_TRUST_REVIEW_COMPLAINTS=3
APP_TRUST_REVIEW_SHARE=0.2

# Вебхуки для ATS: период отправки (0 — выключить). Адреса во внутренней сети
# (localhost, 10.0.0.0/8…) — только явной настройкой для локального приёмника.
APP_WEBHOOK_DISPATCH_INTERVAL_SECONDS=5
# APP_WEBHOOK_ALLOW_PRIVATE_HOSTS=true

# Число процессов uvicorn (читает сам uvicorn)
# WEB_CONCURRENCY=4
